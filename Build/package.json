{
  "name": "muzari",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env BUILD_TARGET=web vite",
    "dev:web": "cross-env BUILD_TARGET=web vite",
    "dev:desktop": "cross-env BUILD_TARGET=desktop tauri dev",
    "build": "cross-env BUILD_TARGET=web vite build",
    "build:single": "cross-env SINGLE_FILE=true npm run build:web",
    "build:web": "cross-env BUILD_TARGET=web vite build",
    "build:desktop": "cross-env BUILD_TARGET=desktop tauri build",
    "tauri": "tauri",
    "start": "cd dist && python3 -m http.server 8000",
    "preview": "vite preview",
    "test": "jest",
    "test:run": "jest --passWithNoTests",
    "test:integration": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config jest.integration.config.cjs",
    "test:e2e": "node tests/e2e/flo/flo_wasm_e2e.ts && node tests/e2e/symphonia/symphonia_e2e.ts",
    "format:wasm": "npx prettier --write src/platform/audio/wasm/symphonia/*.js src/platform/audio/wasm/symphonia/*.ts",
    "build:wasm": "wasm-pack build ../crates/symphonia-wasm --target web --out-dir ../../Build/src/platform/audio/wasm/symphonia --out-name symphonia --release && npm run format:wasm",
    "test:watch": "jest --watch",
    "lint": "eslint 'src/**/*.ts' 'src/**/*.tsx'",
    "make-pretty": "prettier --write 'src/**/*.{ts,tsx,js,jsx,json,css,scss,md,html,cjs}'",
    "count-lines": "cloc . --exclude-dir=node_modules,build,dist --exclude-ext=lock,json",
    "i18n-check": "node i18n-izer.cjs --ignore-console",
    "generate:visualizers": "node scripts/gen-visualizer-registry.cjs",
    "update": "npm-check-updates -i"
  },
  "dependencies": {
    "@audiflo/libflo": "^0.1.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@nisoku/satori": "^0.1.3",
    "@radix-ui/react-collapsible": "^1.1.21",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@reactour/tour": "^3.8.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@uppy/core": "^6.0.1",
    "@uppy/dashboard": "^6.0.0",
    "@uppy/react": "^6.0.0",
    "@web-scrobbler/metadata-filter": "^3.2.0",
    "@zag-js/marquee": "^1.44.0",
    "@zag-js/react": "^1.44.0",
    "dompurify": "^3.4.15",
    "dsssp": "^0.8.0",
    "gsap": "^3.15.0",
    "i18next": "^26.4.4",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.2",
    "lucide-react": "^0.577.0",
    "m3u-parser-generator": "^5.0.2",
    "music-metadata": "^12.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "react-icons": "^5.7.0",
    "sonner": "^2.0.8",
    "tone": "^15.1.22",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/plugin-transform-runtime": "^7.29.0",
    "@tauri-apps/cli": "^2.11.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vite-pwa/assets-generator": "^1.0.4",
    "@vitejs/plugin-react": "^6.1.1",
    "cloc": "^2.11.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "npm-check-updates": "^19.6.3",
    "prettier": "^3.9.8",
    "ts-jest": "^29.4.12",
    "vite": "^8.3.0",
    "vite-plugin-mkcert": "^2.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vite-plugin-wasm": "^3.6.0",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  }
}
